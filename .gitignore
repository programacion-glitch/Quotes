# .gitignore for H2O Quote RPA

# Environment variables (NEVER commit!)
.env
.env.*
!.env.example
.history

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log

# Temporary files
*.tmp
test_output.txt
matching_results.txt
results_display.txt
.playwright-mcp

# Excel temporary files
~$*.xlsx
~$*.xlsb
~$*.xls

# Data (if sensitive) — input Blue Quotes are runtime data, not tracked
data/input/*.pdf
# data/output/*.json

# Claude Code runtime
.claude/scheduled_tasks.lock

# Testing
.pytest_cache/
.coverage
htmlcov/

# Service Account Credentials
config/*.json
data/credentials.json
data/token.json
data/progressive_session.json

# Learned-mappings runtime cache (persists on the data volume / Drive, not in git)
data/learned_mappings.xlsx
